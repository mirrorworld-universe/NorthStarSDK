{
  "name": "@sonicsvm/northstar-sdk",
  "version": "0.1.0",
  "description": "SDK for interacting with Ephemeral Rollups and constructing Portal transactions on Solana",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck:live": "tsc --noEmit --target ES2020 --module commonjs --esModuleInterop --skipLibCheck --strict tests/real-integration.test.ts tests/spl-token-live-e2e.test.ts",
    "test": "jest --testPathIgnorePatterns=real-integration.test.ts spl-token-live-e2e.test.ts --passWithNoTests",
    "test:integration": "jest --runTestsByPath tests/real-integration.test.ts --testTimeout=300000",
    "test:spl-token-live": "jest --runTestsByPath tests/spl-token-live-e2e.test.ts --testTimeout=300000"
  },
  "keywords": [
    "solana",
    "ephemeral-rollup",
    "portal",
    "blockchain"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@dao-xyz/borsh": "^6.0.1",
    "@noble/hashes": "^1.8.0",
    "@solana/web3.js": "^1.99.0",
    "axios": "^1.21.1",
    "bs58": "^6.0.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@jest/test-sequencer": "^29.7.0",
    "@solana/spl-token": "^0.4.15",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
